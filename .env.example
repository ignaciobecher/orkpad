# ────────────────────────────────────────────────────────────────
# ORKPAD — self-host configuration (single file)
#   1. cp .env.example .env
#   2. Generate secrets:  openssl rand -base64 48
#   3. docker compose up -d --build
# Open http://localhost:8080 and register your account.
# ────────────────────────────────────────────────────────────────

# Secrets for signing JWTs (REQUIRED — use long random strings, min 16 chars)
JWT_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-another-long-random-string

# Public origin of the frontend (used for CORS, auth redirects, emails)
FRONTEND_URL=http://localhost:8080

# Public URL the browser uses to reach the API (baked into the frontend build)
VITE_API_URL=http://localhost:3000

# IA local (Ollama). Opcional: sin esto el Asistente IA queda desactivado.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Public base URL of the API (used to build links inside emails)
API_URL=http://localhost:3000

# Archivos: se guardan en el volumen uploads_data (./uploads en local).
# UPLOADS_DIR=/app/uploads

# ────────────────────────────────────────────────────────────────
# OPTIONAL — leave commented to disable
# ────────────────────────────────────────────────────────────────

# Transactional email via Resend. When empty, no emails are sent and new
# accounts are verified immediately at registration (ideal for self-hosting).
# RESEND_API_KEY=
# FROM_EMAIL=no-reply@orkpad.com

# GitHub OAuth app — ONLY used to link repositories to projects
# (login/register is always email + password). Create the app at
# https://github.com/settings/developers and set the callback URL to
# <API_URL>/auth/github/callback. Leave empty to disable.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
# GITHUB_WEBHOOK_SECRET=
