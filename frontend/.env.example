# Base URL of the Orkpad backend API
VITE_API_URL=http://localhost:3000

# Base URL of the backend API for the development environment
VITE_API_URL_DEV=http://localhost:3000

# Base URL of the backend API for the production environment
VITE_API_URL_PROD=http://localhost:3000

# URL of the realtime (socket.io) server
VITE_SOCKET_URL=http://localhost:3000

# Optional: user ID granted admin privileges in the app (leave empty to disable)
VITE_ADMIN_USER_ID=