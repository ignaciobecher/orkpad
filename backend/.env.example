# ────────────────────────────────────────────────────────────────
# ORKPAD — Environment template
# Copy this file to .env and fill in the values for your setup.
#   cp .env.example .env
# All values below are placeholders — never commit real secrets.
# ────────────────────────────────────────────────────────────────

# HTTP port the API listens on
PORT=3000

# Runtime environment: development | test | production
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/orkpad

# Origin of the frontend app (used for CORS, emails, and auth redirects)
FRONTEND_URL=http://localhost:5173

# Secrets for signing JWTs (use long random strings)
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret

# Token lifetimes (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Lifetime of the signed tokens used by shareable project links
PROJECT_LINK_JWT_EXPIRES_IN=4h

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Secret used to validate GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=

# Google OAuth app credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Google Places API key (lead scraping source)
GOOGLE_PLACES_API_KEY=

# Resend API key for transactional emails
RESEND_API_KEY=

# Sender address for outgoing emails
FROM_EMAIL=no-reply@orkpad.com

# Public base URL of this API (used to build links inside emails)
API_URL=http://localhost:3000

# Web push (VAPID) keys — generated with `web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@orkpad.com

# Platform admin user id and the email admin notifications are sent to
# (the same user id is verified by AdminGuard)
ADMIN_USER_ID=
ADMIN_EMAIL=

# (Reserved) Currently not referenced by the source code; kept for future use.
ENCRYPTION_KEY=

# (Reserved) Currently not referenced by the source code; kept for future use.
OPENAI_API_KEY=
OPENAI_MODEL=

# Bearer token used by scripts/seed-resources.ts to seed educational resources
ADMIN_TOKEN=